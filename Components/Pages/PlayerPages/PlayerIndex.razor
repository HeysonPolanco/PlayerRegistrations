@page "/Player-Index"
@using PlayerRegistrations.Models
@using PlayerRegistrations.Services

@inject PlayersService playersService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Player Registration</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Players List</h5>
            <a href="/Player-Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create
            </a>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-3">
                    <label class="form-label"><strong>Filter by</strong></label>
                    <InputSelect class="form-select" @bind-Value="Filter">
                        <option value="" selected disabled>Select</option>
                        <option value="PlayerId">PlayerId</option>
                        <option value="Name">Name</option>
                    </InputSelect>
                </div>
                <div class="col-6">
                    <label class="form-label"><strong>Search</strong></label>
                    <div class="input-group">
                        <input class="form-control" @bind="FilterValue" placeholder="Search..." />
                        <button type="button" class="btn btn-primary" @onclick="Search">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
            </div>

            <table class="table table-bordered table-hover table-light">
                <thead>
                    <tr>
                        <th>PlayerId</th>
                        <th>Name</th>
                        <th>Wins</th>
                        <th>Draws</th>
                        <th>Losses</th>
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in PlayersList)
                    {
                        <tr>
                            <td>@player.PlayerId</td>
                            <td>@player.Name</td>
                            <td>@player.Wins</td>
                            <td>@player.Draws</td>
                            <td>@player.Losses</td>
                            <td class="text-center">
                                <a href="/Player-edit/@player.PlayerId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <label>Total: @PlayersList.Count()</label>
        </div>
    </div>
</div>

@code {
    public List<Players> PlayersList { get; set; } = new();
    public string Filter { get; set; } = string.Empty;
    public string FilterValue { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        PlayersList = await playersService.GetList(p => p.PlayerId > 0);
    }

    private async Task Search()
    {
        if (!string.IsNullOrWhiteSpace(FilterValue))
        {
            if (Filter == "PlayerId" && int.TryParse(FilterValue, out int id))
                PlayersList = await playersService.GetList(p => p.PlayerId == id);
            else if (Filter == "Name")
                PlayersList = await playersService.GetList(p => p.Name.ToLower().Contains(FilterValue.ToLower()));
        }
        else
        {
            PlayersList = await playersService.GetList(p => p.PlayerId > 0);
        }
    }
}
